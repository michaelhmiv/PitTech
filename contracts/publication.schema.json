{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pittech.app/contracts/publication-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "recipe",
        "collection",
        "attempt",
        "cook"
      ]
    },
    "session": {
      "description": "The measured session behind a kind=cook publication: the event the dishes shared. Present (non-null) exactly when kind is cook; enforced by the server validator. Times are offsets from the session start so the payload stays relative-timing only.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "smokerName": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 160
                },
                {
                  "type": "null"
                }
              ]
            },
            "fuelType": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 160
                },
                {
                  "type": "null"
                }
              ]
            },
            "woodOrPelletBlend": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 160
                },
                {
                  "type": "null"
                }
              ]
            },
            "setpoint": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "value": {
                      "type": "number"
                    },
                    "unit": {
                      "enum": [
                        "°C",
                        "°F"
                      ]
                    }
                  },
                  "required": [
                    "value",
                    "unit"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "outdoorTemperatureValue": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "outdoorTemperatureUnit": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 16
                },
                {
                  "type": "null"
                }
              ]
            },
            "weatherNotes": {
              "type": "string",
              "maxLength": 2000
            },
            "windNotes": {
              "type": "string",
              "maxLength": 2000
            },
            "notes": {
              "type": "string",
              "maxLength": 2000
            },
            "serveAtOffsetMillis": {
              "description": "Planned serve time (from the serve plan that started this cook) as an offset from the session start; null when the cook had no plan.",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "durationMillis": {
              "description": "Session length (cook end minus cook start); null when the session end was not recorded.",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "smokerName",
            "fuelType",
            "woodOrPelletBlend",
            "setpoint",
            "outdoorTemperatureValue",
            "outdoorTemperatureUnit",
            "weatherNotes",
            "windNotes",
            "notes",
            "serveAtOffsetMillis",
            "durationMillis"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "identityMode": {
      "enum": [
        "named",
        "anonymous"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "apps-snacks",
        "beef",
        "chicken",
        "desserts",
        "lamb-game",
        "pork",
        "sausage-links",
        "seafood",
        "sides",
        "turkey",
        "veggies",
        "other"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "revisionId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "foodType": {
            "type": "string",
            "maxLength": 160
          },
          "cut": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "weightGrams": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000
              },
              {
                "type": "null"
              }
            ]
          },
          "method": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 160
                },
                "amount": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "name",
                "amount"
              ]
            },
            "maxItems": 100
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "title": {
                  "type": "string",
                  "maxLength": 160
                },
                "details": {
                  "type": "string",
                  "maxLength": 2000
                },
                "action": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 80
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "suggestedOffsetMillis": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "method": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 160
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "title",
                "details",
                "action",
                "suggestedOffsetMillis"
              ]
            },
            "maxItems": 100
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            },
            "maxItems": 20
          },
          "story": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "attemptId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "foodOnOffsetMillis": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "foodOffOffsetMillis": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "channels": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "maxLength": 80
                        },
                        "role": {
                          "enum": [
                            "food",
                            "pit"
                          ]
                        },
                        "label": {
                          "type": "string",
                          "maxLength": 160
                        }
                      },
                      "required": [
                        "id",
                        "role",
                        "label"
                      ]
                    },
                    "maxItems": 32
                  },
                  "measurements": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "offsetMillis": {
                          "type": "integer",
                          "minimum": -604800000,
                          "maximum": 2592000000
                        },
                        "channelId": {
                          "type": "string",
                          "maxLength": 80
                        },
                        "role": {
                          "enum": [
                            "food",
                            "pit"
                          ]
                        },
                        "valueCelsius": {
                          "type": "number",
                          "minimum": -100,
                          "maximum": 1000
                        },
                        "quality": {
                          "enum": [
                            "measured",
                            "manual",
                            "recovered"
                          ]
                        }
                      },
                      "required": [
                        "offsetMillis",
                        "channelId",
                        "role",
                        "valueCelsius",
                        "quality"
                      ]
                    },
                    "maxItems": 250000
                  },
                  "milestones": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "offsetMillis": {
                          "type": "integer"
                        },
                        "action": {
                          "type": "string",
                          "maxLength": 80
                        },
                        "text": {
                          "type": "string",
                          "maxLength": 2000
                        }
                      },
                      "required": [
                        "id",
                        "offsetMillis",
                        "action",
                        "text"
                      ]
                    },
                    "maxItems": 1000
                  },
                  "verdict": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "rating": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 1,
                            "maximum": 5
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "cookAgain": {
                        "anyOf": [
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "notes": {
                        "type": "string",
                        "maxLength": 2000
                      }
                    },
                    "required": [
                      "rating",
                      "cookAgain",
                      "notes"
                    ]
                  },
                  "gaps": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "channelId": {
                          "type": "string",
                          "maxLength": 80
                        },
                        "fromMillis": {
                          "type": "integer"
                        },
                        "toMillis": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "channelId",
                        "fromMillis",
                        "toMillis"
                      ]
                    },
                    "maxItems": 1000
                  },
                  "anchorOffsetMillis": {
                    "description": "Where this dish's story origin (its food-on anchor, or its first recorded point) sits on the publication session clock. Written only by kind=cook publications; consumers interpret it only when the payload carries a session. Null when the story could not be placed.",
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "inputs": {
                    "description": "The dish's recorded cook inputs (wrap, rub, spritz) lifted from its measured record so consumers read them without the private results rows. Validated at publish time; community aggregation does not read it yet (v1 metrics unchanged).",
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "wrapMaterial": {
                            "anyOf": [
                              {
                                "enum": [
                                  "none",
                                  "foil",
                                  "butcher_paper"
                                ]
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "rub": {
                            "anyOf": [
                              {
                                "type": "string",
                                "maxLength": 160
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "spritz": {
                            "anyOf": [
                              {
                                "type": "boolean"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "spritzMedium": {
                            "anyOf": [
                              {
                                "type": "string",
                                "maxLength": 160
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "wrapMaterial",
                          "rub",
                          "spritz",
                          "spritzMedium"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "attemptId",
                  "foodOnOffsetMillis",
                  "foodOffOffsetMillis",
                  "channels",
                  "measurements",
                  "milestones",
                  "verdict",
                  "gaps"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "path": {
                  "type": "string",
                  "pattern": "^attachments/[a-zA-Z0-9_-]+\\.(jpg|png|webp)$",
                  "maxLength": 160
                },
                "mimeType": {
                  "enum": [
                    "image/jpeg",
                    "image/png",
                    "image/webp"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "caption": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "id",
                "path",
                "mimeType",
                "sha256",
                "caption"
              ]
            },
            "maxItems": 30
          },
          "source": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "itemId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "revisionId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "displayName": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "removed": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "itemId",
                  "revisionId",
                  "removed"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "revisionId",
          "title",
          "description",
          "foodType",
          "cut",
          "weightGrams",
          "method",
          "ingredients",
          "instructions",
          "tags",
          "story",
          "assets",
          "source"
        ]
      },
      "maxItems": 20,
      "minItems": 1
    },
    "source": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "itemId": {
              "type": "string",
              "format": "uuid"
            },
            "revisionId": {
              "type": "string",
              "format": "uuid"
            },
            "displayName": {
              "type": "string",
              "maxLength": 160
            },
            "removed": {
              "type": "boolean"
            }
          },
          "required": [
            "itemId",
            "revisionId",
            "removed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "measuredAttemptId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "heroAssetId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "contractVersion",
    "kind",
    "identityMode",
    "title",
    "recipes",
    "source",
    "measuredAttemptId",
    "heroAssetId"
  ]
}
