{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PitTech prepared share card v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "dishes",
    "hero",
    "unit",
    "curves",
    "channelCount",
    "milestones",
    "stats",
    "note",
    "cropX",
    "cropY",
    "zoom",
    "theme",
    "relay"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "maxLength": 160
    },
    "dishes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string"
      }
    },
    "hero": {
      "enum": [
        "photo",
        "chart",
        "none"
      ]
    },
    "unit": {
      "enum": [
        "°C",
        "°F"
      ]
    },
    "curves": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "label",
          "segments"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                }
              }
            },
            "maxItems": 50
          }
        }
      }
    },
    "channelCount": {
      "type": "integer",
      "minimum": 0
    },
    "milestones": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "dish",
          "title",
          "offsetMillis"
        ],
        "additionalProperties": false,
        "properties": {
          "dish": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "offsetMillis": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "stats": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    },
    "cropX": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "cropY": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "zoom": {
      "type": "number",
      "minimum": 1,
      "maximum": 3
    },
    "theme": {
      "const": "classic"
    },
    "relay": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+){2,5}$"
            },
            "url": {
              "type": "string",
              "pattern": "^https://pittech\\.app/s/[A-Z0-9-]+$"
            }
          }
        }
      ]
    }
  }
}
