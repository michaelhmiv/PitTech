{
  "compilerOptions": {
    "target": "ESNext", "module": "NodeNext", "strict": true,
    "noEmit": true, "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true, "verbatimModuleSyntax": true,
    "skipLibCheck": true, "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
}
