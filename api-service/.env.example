# Placeholders only. Staging and production require different databases, buckets, keys and roles.
NODE_ENV=production
PORT=3000
DATABASE_URL=
MIGRATION_DATABASE_URL=
RATE_HMAC_KEY=
OBJECT_STORAGE=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_MAX_BYTES=
DAILY_UPLOAD_MAX_BYTES=
DAILY_UPLOAD_MAX_COUNT=
RELAY_UPLOADS_ENABLED=false
# Explicit trusted ingress CIDRs only; leave empty until ingress is verified.
TRUSTED_PROXY_CIDRS=

# Auth remains disabled until verified PitTech sender, isolated storage and native account gates pass.
AUTH_ENABLED=false
AUTH_HASH_KEY=
AUTH_ENCRYPTION_KEY=
RESEND_API_KEY=
AUTH_FROM=
AUTH_PUBLIC_ORIGIN=
AUTH_DAILY_EMAIL_LIMIT=

# Community lifecycle remains disabled pending native/web/provider release evidence.
ACCOUNT_LIFECYCLE_ENABLED=false
LIFECYCLE_DATABASE_URL=
LIFECYCLE_HASH_KEY=
LIFECYCLE_ENCRYPTION_KEY=
PUBLIC_API_ENABLED=false
PUBLIC_MODERATION_READY=false
ACCOUNT_DELETION_READY=false
PUBLIC_STORAGE_MAX_BYTES=
PUBLIC_DAILY_BYTES=
PUBLIC_DAILY_WRITES=
TOTAL_OBJECT_STORAGE_MAX_BYTES=

# Subscriptions remain disabled until store products exist, sandbox evidence
# passes and the paywall UI inventory lands. Product/bundle identifiers and
# store credentials are owner-gated and never committed.
SUBSCRIPTIONS_ENABLED=false
PRO_APPLE_BUNDLE_ID=
PRO_APPLE_PRODUCT_ID=
PRO_APPLE_TRUST_MODE=chain
PRO_APPLE_ROOTS=
PRO_APPLE_PINNED_KEYS=
PRO_APPLE_ISSUER_ID=
PRO_APPLE_KEY_ID=
PRO_APPLE_PRIVATE_KEY=
PRO_GOOGLE_PACKAGE=
