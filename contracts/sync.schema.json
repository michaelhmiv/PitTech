{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pittech.app/contracts/sync-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "baseVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "mutationId": {
      "type": "string",
      "format": "uuid"
    },
    "clientId": {
      "type": "string",
      "format": "uuid"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "maxItems": 100000
    },
    "conflicts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "winner": {
            "$ref": "#/$defs/record"
          },
          "loser": {
            "$ref": "#/$defs/record"
          },
          "reason": {
            "enum": [
              "edit_edit",
              "delete_edit",
              "immutable_identity"
            ]
          }
        },
        "required": [
          "id",
          "winner",
          "loser",
          "reason"
        ]
      }
    },
    "resolvedConflictIds": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "required": [
    "contractVersion",
    "baseVersion",
    "mutationId",
    "clientId",
    "records",
    "conflicts"
  ],
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordType": {
          "enum": [
            "cooks",
            "dishes",
            "ingredients",
            "events",
            "readings",
            "targets",
            "results",
            "devices",
            "probes",
            "photos",
            "recipes",
            "recipeRevisions",
            "recipeAssets",
            "companionRecords",
            "companionPhotos",
            "mealPresets",
            "dishRecipeSources",
            "lifecycles",
            "targetHistory",
            "logReadingLinks",
            "reminderRules"
          ]
        },
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "not": {
            "pattern": "[^A-Za-z0-9:_-]"
          }
        },
        "version": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "counter": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740990
            },
            "clientId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "counter",
            "clientId"
          ]
        },
        "deleted": {
          "type": "boolean"
        },
        "payload": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "assetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "recordType",
        "recordId",
        "version",
        "deleted",
        "payload",
        "assetIds"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "deleted": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "null"
              },
              "assetIds": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "payload": {
                "type": "object"
              }
            }
          }
        }
      ]
    }
  }
}
